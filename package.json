{
  "name": "@chrometaphore/sumi",
  "version": "1.0.0",
  "private": true,
  "description": "Point at any running web app, leave notes, and hand Claude the exact DOM context to act on.",
  "license": "MIT",
  "author": {
    "name": "Lorenzo Buosi (chrometaphore)",
    "url": "https://chrometaphore.com"
  },
  "homepage": "https://github.com/chrometaphore/sumi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrometaphore/sumi.git"
  },
  "bugs": {
    "url": "https://github.com/chrometaphore/sumi/issues"
  },
